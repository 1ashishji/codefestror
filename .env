# ───────────────────────────────────────────────────────────────────────────────
# Enterprise Salary Management System — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ───────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=salary_dev

# ── Database ───────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=password
DB_USERNAME=root
DB_PASSWORD=password
DATABASE_URL=mysql2://root:password@db:3306/hr

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Rails ─────────────────────────────────────────────────────────────────────
# Generate with: rails secret
SECRET_KEY_BASE=a_very_long_secret_key_base_at_least_64_chars_long_1234567890abcdef
RAILS_ENV=development
RAILS_MAX_THREADS=5

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ── Email (Action Mailer) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_smtp_password
