gem "hiredis-client"                        # C-extension for speed

# ── Background Jobs ───────────────────────────────────────────────────────────
gem "sidekiq",          "~> 7.2"

# ── Audit ─────────────────────────────────────────────────────────────────────
gem "paper_trail",      "~> 15.0"

# ── Observability ─────────────────────────────────────────────────────────────
gem "sentry-ruby"
gem "sentry-rails"
gem "sentry-sidekiq"
gem "lograge"

# ── Utilities ─────────────────────────────────────────────────────────────────
